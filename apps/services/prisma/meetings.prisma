generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/meetings-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MEETINGS_DATABASE_URL")
}

model Meeting {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  date       DateTime
  type       String   // Midweek, Weekend, Ministry
  location   String?
  attendance Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
